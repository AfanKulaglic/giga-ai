{
  "name": "giga-ai-assistant",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "shot": "node scripts/screenshot.cjs",
    "ai:check": "tsx --env-file=.env.local scripts/ai-check.ts",
    "scraper:test": "tsx --env-file=.env.local worker/cli.ts --mode=test --limit=10",
    "scraper:full": "tsx --env-file=.env.local worker/cli.ts --mode=full",
    "scraper:status": "tsx --env-file=.env.local worker/cli.ts --mode=status",
    "scraper:sync": "tsx --env-file=.env.local worker/cli.ts --mode=sync",
    "scraper:schedule": "tsx --env-file=.env.local worker/cli.ts --mode=schedule",
    "migrate:rtdb": "tsx scripts/migrate-local-to-rtdb.ts",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true});console.log('.next obrisan')\""
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.6",
    "clsx": "^2.1.1",
    "firebase": "^11.6.0",
    "firebase-admin": "^13.2.0",
    "lucide-react": "^0.487.0",
    "next": "^15.2.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.2.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "autoprefixer": "^10.4.21",
    "dotenv": "^16.5.0",
    "postcss": "^8.5.3",
    "puppeteer-core": "^25.18.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
