# ---------------------------------------------------------------------------
# GIGA.ba AI asistent — primjer konfiguracije
# Kopirajte u `.env.local` i popunite stvarne vrijednosti. Nikada ne commitujte
# `.env.local` niti stvarne ključeve.
# ---------------------------------------------------------------------------

# ------------------------------- AI model ----------------------------------
# OpenAI-kompatibilan endpoint. Podrazumijevano: Groq besplatni nivo.
# Ključ: https://console.groq.com/keys  (bez kartice)
AI_PROVIDER=groq
GROQ_API_KEY=
# Model mora podržavati pozivanje alatki (tools):
# openai/gpt-oss-120b (podrazumijevano) · openai/gpt-oss-20b · qwen/qwen3.8-27b
# AI_MODEL=openai/gpt-oss-120b

# Više ključeva istog provajdera (npr. dva besplatna Gemini naloga): kad prvi
# dostigne dnevni limit, drugi se preuzima automatski, bez restarta.
# GEMINI_API_KEY_2=...
# GEMINI_API_KEY_3=...
# Ili sve odjednom: AI_API_KEYS=kljuc1,kljuc2

# --- Alternative (postavite AI_PROVIDER i odgovarajući ključ) --------------
# DeepSeek (plaćeni):
# DEEPSEEK_API_KEY=sk-...
# Google Gemini (besplatni nivo ~10 zahtjeva/min, 1.500/dan):
# GEMINI_API_KEY=...
# OpenRouter (modeli sa sufiksom ":free"):
# OPENROUTER_API_KEY=...
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free
# Lokalni Ollama (bez ključa): AI_PROVIDER=ollama
# Bilo koji OpenAI-kompatibilni endpoint:
# AI_BASE_URL=https://vas-endpoint/v1
# AI_API_KEY=...

# Opciono:
# AI_TIMEOUT_MS=60000
# AI_MAX_TOOL_ROUNDS=3
# AI_CONTEXT_MESSAGES=10

# ------------------------------- Firebase ----------------------------------
# Bez Firebase konfiguracije aplikacija radi u lokalnom načinu (jedan korisnik,
# lokalna JSON baza u .data/). Za produkciju obavezno popunite oba bloka.

# --- Realtime Database (preporučeno za ovaj projekat) ----------------------
# Ako je FIREBASE_DB_URL postavljen, podaci idu u Realtime Database.
# URL: Firebase konzola → Realtime Database → Data (piše na vrhu tabele).
FIREBASE_DB_URL=
# Servisni račun kao putanja do .json fajla (najsigurnije — ključ van projekta),
# ili kao base64/JSON u jednoj varijabli.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Nacin prijave:
#   password = jedna zajednicka sifra (podrazumijevano, APP_PASSWORD ispod)
#   firebase = pravi nalozi (Email/Password + AUTHORIZED_EMAILS)
#   local    = bez ikakve prijave (samo za potpuno privatan racunar)
AUTH_MODE=password
APP_PASSWORD=2026
# Opciono: tajna za potpisivanje sesijskog kolacica (bez nje se izvodi iz sifre).
AUTH_SECRET=

# Alternativa: Firestore (ako FIREBASE_DB_URL nije postavljen)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Privatni ključ u jednom redu, sa \n escape sekvencama:
FIREBASE_PRIVATE_KEY=

# Client SDK (browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Samo ovi nalozi smiju koristiti aplikaciju. Odvojeni zarezom.
# Prazno = svaki autentificirani Firebase nalog (ne preporučuje se u produkciji).
AUTHORIZED_EMAILS=

# Lokalni način rada je dozvoljen samo ako ovo nije "false".
ALLOW_LOCAL_MODE=true

# ------------------------------- Scraper -----------------------------------
GIGA_BASE_URL=https://giga.ba
SCRAPER_PAGE_SIZE=250
# Broj paralelnih zahtjeva. Sajt agresivno ograničava promet — držite nisko.
SCRAPER_CONCURRENCY=2
# Pauza između zahtjeva u ms.
SCRAPER_DELAY_MS=600
SCRAPER_MAX_RETRIES=4
# Interval automatske sinhronizacije u minutama (minimalno 5).
# Provjera stvarnog stanja (cijena/dostupnost) na giga.ba u momentu odgovora.
# 'false' = koristi samo kopiju iz baze.
LIVE_SITE_CHECK=true
# Najmanji razmak između dvije ručne sinhronizacije (sekunde).
SCRAPER_MIN_INTERVAL_SECONDS=60
SCRAPER_INTERVAL_MINUTES=360
# SCRAPER_USER_AGENT=GIGA-Assistant/0.1 (+kontakt email)

# Automatsko osvježavanje cijelog kataloga u pozadini (minute, 0 = isključeno).
# 10 zahtjeva po ciklusu; detaljna provjera ide uz odgovor/narudžbu.
# Tvrda granica prema giga.ba: najviše zahtjeva na sat i minimalni razmak.
SITE_MAX_REQUESTS_PER_HOUR=120
SITE_MIN_GAP_MS=250
AUTO_SYNC_MINUTES=60
